@model EduSupport.Web.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Sign In";
}

<div class="auth-page">

    <div class="auth-card">

        <div class="auth-brand">
            <div class="auth-logo">E</div>

            <div>
                <div class="auth-brand-name">
                    EduSupport
                </div>

                <div class="auth-brand-subtitle">
                    Student Support Portal
                </div>
            </div>
        </div>

        <div class="auth-heading">
            <h1>Welcome back</h1>

            <p>
                Sign in to access your support workspace.
            </p>
        </div>

        <form asp-action="Login"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="returnUrl"
                   value="@ViewBag.ReturnUrl" />

            <div asp-validation-summary="ModelOnly"
                 class="validation-summary">
            </div>

            <div class="form-group">

                <label asp-for="Email"
                       class="form-label">
                </label>

                <input asp-for="Email"
                       class="form-control"
                       placeholder="you@example.com"
                       autocomplete="email" />

                <span asp-validation-for="Email"
                      class="field-validation">
                </span>

            </div>

            <div class="form-group">

                <label asp-for="Password"
                       class="form-label">
                </label>

                <input asp-for="Password"
                       class="form-control"
                       placeholder="Enter your password"
                       autocomplete="current-password" />

                <span asp-validation-for="Password"
                      class="field-validation">
                </span>

            </div>

            <div class="remember-row">

                <label>
                    <input asp-for="RememberMe" />
                    Remember me
                </label>

            </div>

            <button type="submit"
                    class="btn btn-primary btn-full">
                Sign In
            </button>

        </form>

        <div class="demo-login">

            <strong>Demo Accounts</strong>

            <div>Student: rahul@student.edu</div>
            <div>Manager: meena.manager@edusupport.edu</div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}